{
  "_doc": "AK4 PUPPI jets. Energy fractions are kept raw so jet ID can be re-derived offline (Run 3 WPs are in SamplesFromDAS/CLAUDE.md) rather than frozen into the ntuple.",
  "_todo": "add slimmedJetsAK8 if boosted DV topologies enter scope; add calo jets for the displaced-jet trigger study.",

  "collections": {
    "Jet": {
      "type": "patJet",
      "src": "slimmedJetsPuppi",
      "cut": "pt > 20 && abs(eta) < 5.0",
      "maxLen": 40,
      "doc": "AK4 PUPPI jets, pT > 20 GeV",
      "variables": {
        "pt":            {"expr": "pt()", "type": "float", "doc": "corrected pT [GeV]", "precision": 10},
        "eta":           {"expr": "eta()", "type": "float", "doc": "pseudorapidity", "precision": 12},
        "phi":           {"expr": "phi()", "type": "float", "doc": "azimuthal angle", "precision": 12},
        "mass":          {"expr": "mass()", "type": "float", "doc": "corrected mass [GeV]", "precision": 10},
        "rawFactor":     {"expr": "1.-jecFactor('Uncorrected')", "type": "float", "doc": "1 - (raw pT)/(corrected pT)", "precision": 10},
        "area":          {"expr": "jetArea()", "type": "float", "doc": "catchment area, for JECs", "precision": 10},

        "chHEF":         {"expr": "chargedHadronEnergyFraction()", "type": "float", "doc": "charged hadron energy fraction", "precision": 8},
        "neHEF":         {"expr": "neutralHadronEnergyFraction()", "type": "float", "doc": "neutral hadron energy fraction", "precision": 8},
        "chEmEF":        {"expr": "chargedEmEnergyFraction()", "type": "float", "doc": "charged EM energy fraction", "precision": 8},
        "neEmEF":        {"expr": "neutralEmEnergyFraction()", "type": "float", "doc": "neutral EM energy fraction", "precision": 8},
        "muEF":          {"expr": "muonEnergyFraction()", "type": "float", "doc": "muon energy fraction", "precision": 8},
        "nConstituents": {"expr": "numberOfDaughters()", "type": "uint8", "doc": "number of PF constituents"},
        "chMultiplicity":{"expr": "chargedMultiplicity()", "type": "uint8", "doc": "charged constituent multiplicity"},
        "neMultiplicity":{"expr": "neutralMultiplicity()", "type": "uint8", "doc": "neutral constituent multiplicity"},

        "btagDeepFlavB": {"expr": "bDiscriminator('pfDeepFlavourJetTags:probb')+bDiscriminator('pfDeepFlavourJetTags:probbb')+bDiscriminator('pfDeepFlavourJetTags:problepb')", "type": "float", "doc": "DeepJet b+bb+lepb", "precision": 10},
        "btagUParTAK4B": {"expr": "bDiscriminator('pfUnifiedParticleTransformerAK4DiscriminatorsJetTags:BvsAll')", "type": "float", "doc": "UnifiedParT b vs udscg (-1000 if the tagger is absent in this MiniAOD version)", "precision": 10},

        "nSVs":          {"expr": "?hasOverlaps('vertices')?overlaps('vertices').size():0", "type": "uint8", "doc": "IVF secondary vertices associated to this jet"},
        "nMuons":        {"expr": "?hasOverlaps('muons')?overlaps('muons').size():0", "type": "uint8", "doc": "muons overlapping the jet"},
        "nElectrons":    {"expr": "?hasOverlaps('electrons')?overlaps('electrons').size():0", "type": "uint8", "doc": "electrons overlapping the jet"}
      }
    }
  }
}
