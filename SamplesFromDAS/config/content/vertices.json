{
  "_doc": "IVF secondary vertices from MiniAOD. NOT the analysis displaced vertices - those are refit from tracks by a dedicated producer (see docs/PLAN.txt, milestone 4). Kept now as a cross-check and a stand-in so the rest of the chain can be built and tested.",

  "collections": {
    "SV": {
      "type": "secondaryVertex",
      "src": "slimmedSecondaryVertices",
      "cut": "",
      "maxLen": 30,
      "doc": "inclusive vertex finder (IVF) secondary vertices",
      "variables": {
        "x":       {"expr": "position().x()", "type": "float", "doc": "SV x [cm]", "precision": 12},
        "y":       {"expr": "position().y()", "type": "float", "doc": "SV y [cm]", "precision": 12},
        "z":       {"expr": "position().z()", "type": "float", "doc": "SV z [cm]", "precision": 14},
        "pt":      {"expr": "pt()", "type": "float", "doc": "vector-summed pT of the tracks [GeV]", "precision": 10},
        "eta":     {"expr": "eta()", "type": "float", "doc": "pseudorapidity of the track sum", "precision": 12},
        "phi":     {"expr": "phi()", "type": "float", "doc": "azimuth of the track sum", "precision": 12},
        "mass":    {"expr": "mass()", "type": "float", "doc": "invariant mass of the tracks [GeV]", "precision": 10},
        "ndof":    {"expr": "vertexNdof()", "type": "float", "doc": "degrees of freedom of the fit", "precision": 8},
        "chi2":    {"expr": "vertexNormalizedChi2()", "type": "float", "doc": "chi2/ndof of the fit", "precision": 8},
        "nTracks": {"expr": "numberOfDaughters()", "type": "uint8", "doc": "number of tracks in the vertex"},
        "rho":     {"expr": "vertex().Rho()", "type": "float", "doc": "transverse distance from (0,0) [cm]", "precision": 12}
      }
    }
  }
}
