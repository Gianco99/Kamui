{
  "_doc": "Track-level content: the input to offline displaced vertexing. This is by far the biggest table, so the cut here is the main storage lever - see the size table in SamplesFromDAS/CLAUDE.md.",
  "_note": "MiniAOD has no reco::Track collection. Tracks live inside pat::PackedCandidate: packedPFCandidates (in a PF candidate) plus lostTracks (not in any). A displaced-vertex analysis needs BOTH - displaced tracks frequently fail PF association and land in lostTracks.",

  "collections": {
    "Track": {
      "type": "packedCandidate",
      "src": "packedPFCandidates",
      "cut": "charge != 0 && hasTrackDetails() && pt > 1.0",
      "doc": "charged packedPFCandidates with full track details, pT > 1 GeV",
      "variables": {
        "pt":         {"expr": "pt()", "type": "float", "doc": "track pT [GeV]", "precision": 10},
        "eta":        {"expr": "eta()", "type": "float", "doc": "pseudorapidity", "precision": 12},
        "phi":        {"expr": "phi()", "type": "float", "doc": "azimuthal angle", "precision": 12},
        "charge":     {"expr": "charge()", "type": "int16", "doc": "electric charge"},
        "pdgId":      {"expr": "pdgId()", "type": "int16", "doc": "PF candidate PDG id"},
        "dxy":        {"expr": "dxy()", "type": "float", "doc": "dxy wrt the associated PV [cm]", "precision": 12},
        "dxyErr":     {"expr": "dxyError()", "type": "float", "doc": "dxy uncertainty [cm]", "precision": 10},
        "dz":         {"expr": "dz()", "type": "float", "doc": "dz wrt the associated PV [cm]", "precision": 12},
        "dzErr":      {"expr": "dzError()", "type": "float", "doc": "dz uncertainty [cm]", "precision": 10},
        "ptErr":      {"expr": "?hasTrackDetails()?pseudoTrack().ptError():-1", "type": "float", "doc": "pT uncertainty [GeV]", "precision": 10},
        "normChi2":   {"expr": "?hasTrackDetails()?pseudoTrack().normalizedChi2():-1", "type": "float", "doc": "track fit chi2/ndof", "precision": 8},
        "nHits":      {"expr": "numberOfHits()", "type": "uint8", "doc": "total tracker hits"},
        "nPixelHits": {"expr": "numberOfPixelHits()", "type": "uint8", "doc": "pixel hits"},
        "nPixelLayers": {"expr": "pixelLayersWithMeasurement()", "type": "uint8", "doc": "pixel layers with a measurement"},
        "nStripLayers": {"expr": "stripLayersWithMeasurement()", "type": "uint8", "doc": "strip layers with a measurement"},
        "highPurity": {"expr": "trackHighPurity()", "type": "bool", "doc": "track passes highPurity"},
        "fromPV":     {"expr": "fromPV()", "type": "uint8", "doc": "PV association quality (3 = used in PV fit, 0 = unrelated)"},
        "pvIdx":      {"expr": "vertexRef().key()", "type": "int16", "doc": "index into the PV collection this track is associated with"},
        "lostInnerHits": {"expr": "lostInnerHits()", "type": "int16", "doc": "-1 valid inner hit, 0 none lost, 1+ inner hits lost (displaced-track handle)"}
      }
    },

    "LostTrack": {
      "type": "packedCandidate",
      "src": "lostTracks",
      "cut": "charge != 0 && hasTrackDetails() && pt > 1.0",
      "doc": "tracks not associated to any PF candidate - a large fraction of genuinely displaced tracks",
      "variables": {
        "pt":         {"expr": "pt()", "type": "float", "doc": "track pT [GeV]", "precision": 10},
        "eta":        {"expr": "eta()", "type": "float", "doc": "pseudorapidity", "precision": 12},
        "phi":        {"expr": "phi()", "type": "float", "doc": "azimuthal angle", "precision": 12},
        "charge":     {"expr": "charge()", "type": "int16", "doc": "electric charge"},
        "dxy":        {"expr": "dxy()", "type": "float", "doc": "dxy wrt the associated PV [cm]", "precision": 12},
        "dxyErr":     {"expr": "dxyError()", "type": "float", "doc": "dxy uncertainty [cm]", "precision": 10},
        "dz":         {"expr": "dz()", "type": "float", "doc": "dz wrt the associated PV [cm]", "precision": 12},
        "dzErr":      {"expr": "dzError()", "type": "float", "doc": "dz uncertainty [cm]", "precision": 10},
        "normChi2":   {"expr": "?hasTrackDetails()?pseudoTrack().normalizedChi2():-1", "type": "float", "doc": "track fit chi2/ndof", "precision": 8},
        "nHits":      {"expr": "numberOfHits()", "type": "uint8", "doc": "total tracker hits"},
        "nPixelHits": {"expr": "numberOfPixelHits()", "type": "uint8", "doc": "pixel hits"},
        "nPixelLayers": {"expr": "pixelLayersWithMeasurement()", "type": "uint8", "doc": "pixel layers with a measurement"},
        "nStripLayers": {"expr": "stripLayersWithMeasurement()", "type": "uint8", "doc": "strip layers with a measurement"},
        "highPurity": {"expr": "trackHighPurity()", "type": "bool", "doc": "track passes highPurity"},
        "lostInnerHits": {"expr": "lostInnerHits()", "type": "int16", "doc": "-1 valid inner hit, 0 none lost, 1+ inner hits lost"}
      }
    }
  }
}
