#!/usr/bin/env python3
"""
Kamui CLI entry point. See python/kamui/README.md for details.
"""

# Import Block

## Standard Python imports
import os, sys

## Kamui modules
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "python")) # Lets kamui work from anywhere.
from kamui.cli import main

try:
    sys.exit(main())
except BrokenPipeError:
    ## A reader such as head that stops early closes the pipe, so the rest of the output goes nowhere
    os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    sys.exit(1)
