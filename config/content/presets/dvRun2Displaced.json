{
  "_doc": "Run 2 validation, displacement-triggered channel. Overrides dvFull for Run 2.",
  "include": [
    "dvFull"
  ],
  "skim": {
    "triggers": "run2Displaced"
  },
  "collections": {
    "Jet": {
      "src": "slimmedJets"
    },
    "Track": {
      "cut": "charge != 0 && hasTrackDetails() && pt > 1.0 && pixelLayersWithMeasurement() >= 2 && stripLayersWithMeasurement() >= 6"
    },
    "LostTrack": {
      "cut": "charge != 0 && hasTrackDetails() && pt > 1.0 && pixelLayersWithMeasurement() >= 2 && stripLayersWithMeasurement() >= 6"
    },
    "Electron": {
      "variables": {
        "cutBased": {
          "expr": "electronID('cutBasedElectronID-Fall17-94X-V2-veto')+electronID('cutBasedElectronID-Fall17-94X-V2-loose')+electronID('cutBasedElectronID-Fall17-94X-V2-medium')+electronID('cutBasedElectronID-Fall17-94X-V2-tight')",
          "type": "uint8",
          "doc": "cut-based Fall17-94X-V2 ID: 0 fail, 1 veto, 2 loose, 3 medium, 4 tight"
        },
        "mvaIsoWP90": {
          "expr": "electronID('mvaEleID-Fall17-iso-V2-wp90')",
          "type": "bool",
          "doc": "MVA iso Fall17-V2 wp90"
        },
        "mvaIsoWP80": {
          "expr": "electronID('mvaEleID-Fall17-iso-V2-wp80')",
          "type": "bool",
          "doc": "MVA iso Fall17-V2 wp80"
        }
      }
    }
  }
}
