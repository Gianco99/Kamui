{
  "collections": {
    "Track": {
      "type": "packedCandidate",
      "src": "packedPFCandidates",
      "cut": "charge != 0 && hasTrackDetails() && pt > 1.0 && pixelLayersWithMeasurement() >= 2 && stripLayersWithMeasurement() >= 6",
      "doc": "Charged PF candidates with track details, passing the collection's cut",
      "variables": {
        "pt": {"expr": "pt()", "type": "float", "doc": "Track pT [GeV]", "precision": 10},
        "eta": {"expr": "eta()", "type": "float", "doc": "Pseudorapidity", "precision": 12},
        "phi": {"expr": "phi()", "type": "float", "doc": "Azimuthal angle [rad]", "precision": 12},
        "charge": {"expr": "charge()", "type": "int16", "doc": "Electric charge"},
        "pdgId": {"expr": "pdgId()", "type": "int16", "doc": "PDG ID of the PF candidate"},
        "dxy": {"expr": "dxy()", "type": "float", "doc": "Transverse impact parameter to the associated PV [cm]", "precision": 12},
        "dxyErr": {"expr": "dxyError()", "type": "float", "doc": "dxy uncertainty [cm]", "precision": 10},
        "dz": {"expr": "dz()", "type": "float", "doc": "Longitudinal impact parameter to the associated PV [cm]", "precision": 12},
        "dzErr": {"expr": "dzError()", "type": "float", "doc": "dz uncertainty [cm]", "precision": 10},
        "ptErr": {"expr": "?hasTrackDetails()?pseudoTrack().ptError():-1", "type": "float", "doc": "pT uncertainty [GeV]", "precision": 10},
        "normChi2": {"expr": "?hasTrackDetails()?pseudoTrack().normalizedChi2():-1", "type": "float", "doc": "Track fit chi2 per degree of freedom", "precision": 8},
        "nHits": {"expr": "numberOfHits()", "type": "uint8", "doc": "Number of tracker hits"},
        "nPixelHits": {"expr": "numberOfPixelHits()", "type": "uint8", "doc": "Number of pixel hits"},
        "nPixelLayers": {"expr": "pixelLayersWithMeasurement()", "type": "uint8", "doc": "Number of pixel layers with a measurement"},
        "nStripLayers": {"expr": "stripLayersWithMeasurement()", "type": "uint8", "doc": "Number of strip layers with a measurement"},
        "highPurity": {"expr": "trackHighPurity()", "type": "bool", "doc": "Passes the highPurity track quality"},
        "fromPV": {"expr": "fromPV()", "type": "uint8", "doc": "Association to the first PV: 0 none, 1 loose, 2 tight, 3 used in its fit"},
        "pvIdx": {"expr": "vertexRef().key()", "type": "int16", "doc": "Index of the associated PV in the PV collection"},
        "lostInnerHits": {"expr": "lostInnerHits()", "type": "int16", "doc": "Missing inner hits: -1 none with a hit in the first barrel pixel layer, 0 none, 1 one, 2 two or more"}
      }
    },
    "LostTrack": {
      "type": "packedCandidate",
      "src": "lostTracks",
      "cut": "charge != 0 && hasTrackDetails() && pt > 1.0 && pixelLayersWithMeasurement() >= 2 && stripLayersWithMeasurement() >= 6",
      "doc": "Tracks left out of the PF candidates, with track details, passing the collection's cut",
      "variables": {
        "pt": {"expr": "pt()", "type": "float", "doc": "Track pT [GeV]", "precision": 10},
        "ptErr": {"expr": "?hasTrackDetails()?pseudoTrack().ptError():-1", "type": "float", "doc": "pT uncertainty [GeV]", "precision": 10},
        "eta": {"expr": "eta()", "type": "float", "doc": "Pseudorapidity", "precision": 12},
        "phi": {"expr": "phi()", "type": "float", "doc": "Azimuthal angle [rad]", "precision": 12},
        "charge": {"expr": "charge()", "type": "int16", "doc": "Electric charge"},
        "dxy": {"expr": "dxy()", "type": "float", "doc": "Transverse impact parameter to the associated PV [cm]", "precision": 12},
        "dxyErr": {"expr": "dxyError()", "type": "float", "doc": "dxy uncertainty [cm]", "precision": 10},
        "dz": {"expr": "dz()", "type": "float", "doc": "Longitudinal impact parameter to the associated PV [cm]", "precision": 12},
        "dzErr": {"expr": "dzError()", "type": "float", "doc": "dz uncertainty [cm]", "precision": 10},
        "normChi2": {"expr": "?hasTrackDetails()?pseudoTrack().normalizedChi2():-1", "type": "float", "doc": "Track fit chi2 per degree of freedom", "precision": 8},
        "nHits": {"expr": "numberOfHits()", "type": "uint8", "doc": "Number of tracker hits"},
        "nPixelHits": {"expr": "numberOfPixelHits()", "type": "uint8", "doc": "Number of pixel hits"},
        "nPixelLayers": {"expr": "pixelLayersWithMeasurement()", "type": "uint8", "doc": "Number of pixel layers with a measurement"},
        "nStripLayers": {"expr": "stripLayersWithMeasurement()", "type": "uint8", "doc": "Number of strip layers with a measurement"},
        "highPurity": {"expr": "trackHighPurity()", "type": "bool", "doc": "Passes the highPurity track quality"},
        "lostInnerHits": {"expr": "lostInnerHits()", "type": "int16", "doc": "Missing inner hits: -1 none with a hit in the first barrel pixel layer, 0 none, 1 one, 2 two or more"}
      }
    }
  }
}
