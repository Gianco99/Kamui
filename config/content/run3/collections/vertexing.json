{
  "collections": {
    "SeedTrack": {
      "type": "seedTrack",
      "src": "packedPFCandidates",
      "seeding": {
        "beamSpot": "offlineBeamSpot",
        "primaryVertices": "offlineSlimmedPrimaryVertices",
        "_goodPv": "The first vertex passing these seeds the dxy_PV cut. With none, the event gets no seed tracks",
        "goodPv": {
          "minNdof": 4,
          "maxAbsZ": 24,
          "maxRho": 2
        },
        "minPt": 1.0,
        "minAbsDxyBs": 0,
        "maxDxyErr": 1e9,
        "minNSigmaDxyBs": 0,
        "minRescaledNSigmaDxyBs": 4.0,
        "minNSigmaDxyPv": 0,
        "minHits": 0,
        "minPixelHits": 0,
        "minPixelLayers": 2,
        "minStripLayers": 6,
        "maxFirstPixelLayer": 1
      },
      "variables": {
        "pt": {
          "expr": "pt()",
          "type": "float",
          "doc": "Track pT [GeV]",
          "precision": -1
        },
        "eta": {
          "expr": "eta()",
          "type": "float",
          "doc": "Pseudorapidity",
          "precision": -1
        },
        "phi": {
          "expr": "phi()",
          "type": "float",
          "doc": "Azimuthal angle",
          "precision": -1
        },
        "charge": {
          "expr": "charge()",
          "type": "int16",
          "doc": "Electric charge"
        },
        "vx": {
          "expr": "vx()",
          "type": "float",
          "doc": "Reference point x [cm]",
          "precision": -1
        },
        "vy": {
          "expr": "vy()",
          "type": "float",
          "doc": "Reference point y [cm]",
          "precision": -1
        },
        "vz": {
          "expr": "vz()",
          "type": "float",
          "doc": "Reference point z [cm]",
          "precision": -1
        },
        "dxyErr": {
          "expr": "dxyError()",
          "type": "float",
          "doc": "dxy uncertainty [cm]",
          "precision": -1
        },
        "dzErr": {
          "expr": "dzError()",
          "type": "float",
          "doc": "dz uncertainty [cm]",
          "precision": -1
        },
        "nPixelLayers": {
          "expr": "hitPattern().pixelLayersWithMeasurement()",
          "type": "uint8",
          "doc": "Pixel layers with a measurement"
        },
        "nStripLayers": {
          "expr": "hitPattern().stripLayersWithMeasurement()",
          "type": "uint8",
          "doc": "Strip layers with a measurement"
        }
      }
    },
    "VertexJet": {
      "_doc": "Jets for shared-jet mitigation. Not written to the ntuple.",
      "type": "vertexJet",
      "src": "slimmedJets",
      "jec": {
        "payload": "AK4PFchs",
        "primaryVertices": "offlineSlimmedPrimaryVertices",
        "levels": ["L1FastJet", "L2Relative", "L3Absolute", "L2L3Residual"]
      },
      "_jetId": "TightLepVeto. No Run 3 working point yet.",
      "jetId": {}
    }
  }
}
