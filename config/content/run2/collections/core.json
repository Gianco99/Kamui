{
  "collections": {
    "PV": {
      "type": "vertex",
      "src": "offlineSlimmedPrimaryVertices",
      "doc": "Offline primary vertices",
      "variables": {
        "x": {"expr": "position().x()", "type": "float", "doc": "PV x [cm]", "precision": -1},
        "y": {"expr": "position().y()", "type": "float", "doc": "PV y [cm]", "precision": -1},
        "z": {"expr": "position().z()", "type": "float", "doc": "PV z [cm]", "precision": -1},
        "xErr": {"expr": "xError()", "type": "float", "doc": "PV x uncertainty [cm]", "precision": 8},
        "yErr": {"expr": "yError()", "type": "float", "doc": "PV y uncertainty [cm]", "precision": 8},
        "zErr": {"expr": "zError()", "type": "float", "doc": "PV z uncertainty [cm]", "precision": 8},
        "ndof": {"expr": "ndof()", "type": "float", "doc": "Vertex fit degrees of freedom", "precision": -1},
        "chi2": {"expr": "normalizedChi2()", "type": "float", "doc": "Vertex fit chi2 per degree of freedom", "precision": -1},
        "isFake": {"expr": "isFake()", "type": "bool", "doc": "Placeholder PV made from the beamspot when no vertex is found"},
        "isGood": {"expr": "!isFake() && ndof() > 4 && abs(position().z()) <= 24 && position().Rho() <= 2", "type": "bool", "doc": "Good PV: not fake, ndof > 4, |z| <= 24 cm, rho <= 2 cm"}
      }
    },
    "BeamSpot": {
      "type": "beamSpot",
      "src": "offlineBeamSpot",
      "variables": {
        "x": {"expr": "x0()", "type": "float", "doc": "Beamspot center x [cm]", "precision": -1},
        "y": {"expr": "y0()", "type": "float", "doc": "Beamspot center y [cm]", "precision": -1},
        "z": {"expr": "z0()", "type": "float", "doc": "Beamspot center z [cm]", "precision": -1},
        "sigmaZ": {"expr": "sigmaZ()", "type": "float", "doc": "Beamspot length in z [cm]", "precision": 10},
        "widthX": {"expr": "BeamWidthX()", "type": "float", "doc": "Transverse width in x [cm]", "precision": 10},
        "widthY": {"expr": "BeamWidthY()", "type": "float", "doc": "Transverse width in y [cm]", "precision": 10},
        "dxdz": {"expr": "dxdz()", "type": "float", "doc": "Beam tilt dx/dz", "precision": -1},
        "dydz": {"expr": "dydz()", "type": "float", "doc": "Beam tilt dy/dz", "precision": -1}
      }
    },
    "MET": {
      "type": "patMET",
      "src": "slimmedMETs",
      "singleton": true,
      "_doc": "The type-1 corrected PF MET.",
      "variables": {
        "pt": {"expr": "pt()", "type": "float", "doc": "MET [GeV]", "precision": 10},
        "phi": {"expr": "phi()", "type": "float", "doc": "MET azimuthal angle [rad]", "precision": 10},
        "sumEt": {"expr": "sumEt()", "type": "float", "doc": "Scalar sum of ET [GeV]", "precision": 10},
        "significance": {"expr": "metSignificance()", "type": "float", "doc": "MET significance", "precision": 10},
        "caloPt": {"expr": "caloMETPt()", "type": "float", "doc": "Calorimeter MET [GeV]", "precision": 10}
      }
    },
    "PuppiMET": {
      "type": "patMET",
      "src": "slimmedMETsPuppi",
      "singleton": true,
      "variables": {
        "pt": {"expr": "pt()", "type": "float", "doc": "PUPPI MET [GeV]", "precision": 10},
        "phi": {"expr": "phi()", "type": "float", "doc": "PUPPI MET azimuthal angle [rad]", "precision": 10},
        "sumEt": {"expr": "sumEt()", "type": "float", "doc": "PUPPI scalar sum of ET [GeV]", "precision": 10}
      }
    },
    "Rho": {
      "type": "global",
      "_doc": "Pileup energy densities.",
      "variables": {
        "fastjetAll": {"src": "fixedGridRhoFastjetAll", "type": "double", "doc": "Rho from all PF candidates"},
        "fastjetCentral": {"src": "fixedGridRhoFastjetCentral", "type": "double", "doc": "Rho from PF candidates with |eta| < 2.5"}
      }
    }
  },
  "triggerBits": {"processes": ["HLT", "PAT", "RECO"]}
}
