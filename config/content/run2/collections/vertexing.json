{
  "collections": {
    "SeedTrack": {
      "type": "seedTrack",
      "src": "packedPFCandidates",
      "seeding": {
        "beamSpot": "offlineBeamSpot",
        "primaryVertices": "offlineSlimmedPrimaryVertices",
        "goodPv": {"ndofAbove": 4, "maxAbsZ": 24, "rhoBelow": 2},
        "ptAbove": 1.0,
        "nSigmaDxyBsAbove": 4.0,
        "minPixelLayers": 2,
        "minStripLayers": 6,
        "maxFirstPixelLayer": 1,
        "trackErrScale": {
          "_doc": "Scales the MC track dxy and dsz uncertainties versus pT to match data, for the nSigmaDxyBsAbove cut and the DV uncertainty refit.",
          "2016APV": {
            "barrelAbsEtaBelow": 1.5,
            "barrel": {"dxy": {"form": "p0-p2*exp(-p1*x)", "p": [0.90391, 0.896, -0.1585]}, "dsz": {"form": "p0-p2*exp(-p1*x)", "p": [0.90834, 0.7094, -0.1133]}, "dxyDsz": {"form": "p0-p2*exp(-p1*x)", "p": [0.7946, 0.294, 0.0963]}},
            "endcap": {"dxy": {"form": "p0-p2*exp(-p1*x)", "p": [0.89441, 0.3372, -0.13827]}, "dsz": {"form": "p0-p2*exp(-p1*x)", "p": [0.89631, 0.1800, -0.11508]}, "dxyDsz": {"form": "p0-p2*exp(-p1*x)+p3*x", "p": [0.73781, 3.41, -6.0, 0.002034]}}
          },
          "2016": {
            "barrelAbsEtaBelow": 1.5,
            "barrel": {"dxy": {"form": "p0", "p": [0.981341]}, "dsz": {"form": "p0-exp(-p1*x+p2)", "p": [1.8725, -0.0005732, -0.1141]}, "dxyDsz": {"form": "p0-p2*exp(-p1*x)", "p": [0.93580, 2.026, 0.350]}},
            "endcap": {"dxy": {"form": "p0", "p": [0.998868]}, "dsz": {"form": "p0-exp(-p1*x+p2)", "p": [1.2526, -0.001625, -1.3885]}, "dxyDsz": {"form": "p0-p2*exp(-p1*x)", "p": [0.9649, 0.080, -0.0512]}}
          },
          "2017": {
            "barrelAbsEtaBelow": 1.5,
            "barrel": {"dxy": {"form": "p0-exp(-p1*x+p2)", "p": [1.17509, 0.771, -1.263]}, "dsz": {"form": "p0-exp(-p1*x+p2)", "p": [1.15733, 1.274, -1.257]}, "dxyDsz": {"form": "p0-p2*exp(-p1*x)", "p": [1.2828, 3.05, -6.1]}},
            "endcap": {"dxy": {"form": "p0-exp(-p1*x+p2)", "p": [1.3108, 0.2508, -0.9690]}, "dsz": {"form": "p0-exp(-p1*x+p2)", "p": [1.2758, 0.1959, -1.1719]}, "dxyDsz": {"form": "p0-p2*exp(-p1*x)", "p": [1.526, 0.285, -0.375]}}
          },
          "2018": {
            "barrelAbsEtaBelow": 1.5,
            "barrel": {"dxy": {"form": "p0-exp(-p1*x+p2)", "p": [1.09967, 1.582, -0.842]}, "dsz": {"form": "p0-exp(-p1*x+p2)", "p": [1.11861, 3.14, 0.91]}, "dxyDsz": {"form": "p0-p2*exp(-p1*x)", "p": [1.0866, 0.595, -0.2691]}},
            "endcap": {"dxy": {"form": "p0-exp(-p1*x+p2)", "p": [1.1875, 0.3201, -1.4224]}, "dsz": {"form": "p0-exp(-p1*x+p2)", "p": [1.06183, 0.402, -2.5405]}, "dxyDsz": {"form": "p0-p2*exp(-p1*x)", "p": [1.259, 0.097, -0.197]}}
          }
        },
        "trackDrop": {
          "_doc": "Drops MC tracks at random, more often the farther they are from the beamspot, to match the displaced track efficiency in data.",
          "coefficient": {"2016APV": 1.24, "2016": 1.24, "2017": 1.12, "2018": 1.12},
          "absDxyBsCap": 0.3
        }
      },
      "variables": {
        "pt": {"expr": "pt()", "type": "float", "doc": "Track pT [GeV]", "precision": -1},
        "eta": {"expr": "eta()", "type": "float", "doc": "Pseudorapidity", "precision": -1},
        "phi": {"expr": "phi()", "type": "float", "doc": "Azimuthal angle", "precision": -1},
        "charge": {"expr": "charge()", "type": "int16", "doc": "Electric charge"},
        "vx": {"expr": "vx()", "type": "float", "doc": "Reference point x [cm]", "precision": -1},
        "vy": {"expr": "vy()", "type": "float", "doc": "Reference point y [cm]", "precision": -1},
        "vz": {"expr": "vz()", "type": "float", "doc": "Reference point z [cm]", "precision": -1},
        "dxyErr": {"expr": "dxyError()", "type": "float", "doc": "dxy uncertainty [cm]", "precision": -1},
        "dzErr": {"expr": "dzError()", "type": "float", "doc": "dz uncertainty [cm]", "precision": -1},
        "nPixelLayers": {"expr": "hitPattern().pixelLayersWithMeasurement()", "type": "uint8", "doc": "Pixel layers with a measurement"},
        "nStripLayers": {"expr": "hitPattern().stripLayersWithMeasurement()", "type": "uint8", "doc": "Strip layers with a measurement"}
      }
    },
    "VertexJet": {
      "_doc": "Jets the vertexer uses to separate vertices that share a jet. Not written to the ntuple.",
      "type": "vertexJet",
      "src": "slimmedJets",
      "jec": {"payload": "AK4PFchs", "primaryVertices": "offlineSlimmedPrimaryVertices", "levels": ["L1FastJet", "L2Relative", "L3Absolute", "L2L3Residual"]},
      "requirements": [{"definition": "analysisJet"}]
    },
    "DV": {
      "type": "dv",
      "src": "SeedTrack",
      "vertexing": {
        "beamSpot": "offlineBeamSpot",
        "jets": "VertexJet",
        "minTracks": 3,
        "maxChi2PerDof": 5,
        "kalman": {"maxDistance": 0.01, "maxIterations": 10, "smoothing": true},
        "sharedTracks": {"_doc": "When two vertices share a track, they merge if they are close, and otherwise the track stays only in the vertex it fits best.", "mergeBelowSigma": 4, "keepBelowSigma": 5, "tieBelowSigma": 1.5},
        "zRefit": {"_doc": "A track whose removal moves the vertex in z by more than maxShiftSigma standard deviations is dropped.", "maxShiftSigma": 3},
        "mergeNearby": {"deltaPhiBelow": 0.5, "distance2dBelow": 0.03, "dbvAbove": 0.01},
        "sharedJets": {"_doc": "When two vertices share a jet, a vertex's only track in that jet is dropped if its phi differs from the vertex's phi by more than maxDeltaPhi.", "maxDeltaPhi": 1.5707963267948966},
        "beampipe": {
          "_doc": "A DV is inside the beampipe when its x-y distance from the beampipe center is below radius. Data centers each era on the measured beampipe position, MC on mcCenter.",
          "radius": {"2016APV": 2.00, "2016": 2.00, "2017": 2.09, "2018": 2.09},
          "dataCenter": {"2016APV": [0.124, 0.07], "2016": [0.124, 0.07], "2017": [0.113, -0.180], "2018": [0.171, -0.175]},
          "mcCenter": [0, 0]
        }
      },
      "variables": {
        "x": {"expr": "x()", "type": "float", "doc": "DV x [cm]", "precision": -1},
        "y": {"expr": "y()", "type": "float", "doc": "DV y [cm]", "precision": -1},
        "z": {"expr": "z()", "type": "float", "doc": "DV z [cm]", "precision": -1},
        "cxx": {"expr": "covariance(0,0)", "type": "float", "doc": "Position covariance xx [cm^2]", "precision": -1},
        "cxy": {"expr": "covariance(0,1)", "type": "float", "doc": "Position covariance xy [cm^2]", "precision": -1},
        "cxz": {"expr": "covariance(0,2)", "type": "float", "doc": "Position covariance xz [cm^2]", "precision": -1},
        "cyy": {"expr": "covariance(1,1)", "type": "float", "doc": "Position covariance yy [cm^2]", "precision": -1},
        "cyz": {"expr": "covariance(1,2)", "type": "float", "doc": "Position covariance yz [cm^2]", "precision": -1},
        "czz": {"expr": "covariance(2,2)", "type": "float", "doc": "Position covariance zz [cm^2]", "precision": -1},
        "chi2": {"expr": "chi2()", "type": "float", "doc": "Vertex fit chi2", "precision": -1},
        "ndof": {"expr": "ndof()", "type": "float", "doc": "Vertex fit ndof", "precision": -1},
        "nTracks": {"expr": "tracksSize()", "type": "uint8", "doc": "Seed tracks in the vertex"}
      }
    },
    "DVTrack": {
      "type": "dvTrack",
      "src": "DV",
      "doc": "Seed tracks of every DV, one row per track, in the order the DV fit took them",
      "variables": {
        "charge": {"expr": "charge()", "type": "int16", "doc": "Electric charge"},
        "chi2": {"expr": "chi2()", "type": "float", "doc": "Track fit chi2", "precision": -1},
        "ndof": {"expr": "ndof()", "type": "float", "doc": "Track fit ndof", "precision": -1},
        "vx": {"expr": "vx()", "type": "double", "doc": "Reference point x [cm]"},
        "vy": {"expr": "vy()", "type": "double", "doc": "Reference point y [cm]"},
        "vz": {"expr": "vz()", "type": "double", "doc": "Reference point z [cm]"},
        "px": {"expr": "px()", "type": "double", "doc": "Momentum x [GeV]"},
        "py": {"expr": "py()", "type": "double", "doc": "Momentum y [GeV]"},
        "pz": {"expr": "pz()", "type": "double", "doc": "Momentum z [GeV]"},
        "cov00": {"expr": "covariance(0,0)", "type": "float", "doc": "Track parameter covariance, qoverp qoverp", "precision": -1},
        "cov01": {"expr": "covariance(0,1)", "type": "float", "doc": "Track parameter covariance, qoverp lambda", "precision": -1},
        "cov02": {"expr": "covariance(0,2)", "type": "float", "doc": "Track parameter covariance, qoverp phi", "precision": -1},
        "cov03": {"expr": "covariance(0,3)", "type": "float", "doc": "Track parameter covariance, qoverp dxy", "precision": -1},
        "cov04": {"expr": "covariance(0,4)", "type": "float", "doc": "Track parameter covariance, qoverp dsz", "precision": -1},
        "cov11": {"expr": "covariance(1,1)", "type": "float", "doc": "Track parameter covariance, lambda lambda", "precision": -1},
        "cov12": {"expr": "covariance(1,2)", "type": "float", "doc": "Track parameter covariance, lambda phi", "precision": -1},
        "cov13": {"expr": "covariance(1,3)", "type": "float", "doc": "Track parameter covariance, lambda dxy", "precision": -1},
        "cov14": {"expr": "covariance(1,4)", "type": "float", "doc": "Track parameter covariance, lambda dsz", "precision": -1},
        "cov22": {"expr": "covariance(2,2)", "type": "float", "doc": "Track parameter covariance, phi phi", "precision": -1},
        "cov23": {"expr": "covariance(2,3)", "type": "float", "doc": "Track parameter covariance, phi dxy", "precision": -1},
        "cov24": {"expr": "covariance(2,4)", "type": "float", "doc": "Track parameter covariance, phi dsz", "precision": -1},
        "cov33": {"expr": "covariance(3,3)", "type": "float", "doc": "Track parameter covariance, dxy dxy", "precision": -1},
        "cov34": {"expr": "covariance(3,4)", "type": "float", "doc": "Track parameter covariance, dxy dsz", "precision": -1},
        "cov44": {"expr": "covariance(4,4)", "type": "float", "doc": "Track parameter covariance, dsz dsz", "precision": -1}
      }
    }
  }
}
