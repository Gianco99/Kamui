{
  "collections": {
    "SeedTrack": {
      "type": "seedTrack",
      "src": "packedPFCandidates",
      "seeding": {
        "beamSpot": "offlineBeamSpot",
        "primaryVertices": "offlineSlimmedPrimaryVertices",
        "goodPv": {"ndofAbove": 4, "maxAbsZ": 24, "rhoBelow": 2},
        "ptAbove": 1.0,
        "nSigmaDxyBsAbove": 4.0,
        "minPixelLayers": 2,
        "minStripLayers": 6,
        "maxFirstPixelLayer": 1,
        "dxyErrScale": {
          "_doc": "Scales the MC track dxy uncertainty versus pT to match data, for the nSigmaDxyBsAbove significance cut.",
          "2016APV": {"form": "p0-p2*exp(-p1*x)", "barrelAbsEtaBelow": 1.5, "barrel": [0.90391, 0.896, -0.1585], "endcap": [0.89441, 0.3372, -0.13827]},
          "2016": {"form": "p0", "barrelAbsEtaBelow": 1.5, "barrel": [0.981341], "endcap": [0.998868]},
          "2017": {"form": "p0-exp(-p1*x+p2)", "barrelAbsEtaBelow": 1.5, "barrel": [1.17509, 0.771, -1.263], "endcap": [1.3108, 0.2508, -0.9690]},
          "2018": {"form": "p0-exp(-p1*x+p2)", "barrelAbsEtaBelow": 1.5, "barrel": [1.09967, 1.582, -0.842], "endcap": [1.1875, 0.3201, -1.4224]}
        },
        "trackDrop": {
          "_doc": "Drops MC tracks at random, more often the farther they are from the beamspot, to match the displaced track efficiency in data.",
          "coefficient": {"2016APV": 1.24, "2016": 1.24, "2017": 1.12, "2018": 1.12},
          "absDxyBsCap": 0.3
        }
      },
      "variables": {
        "pt": {"expr": "pt()", "type": "float", "doc": "Track pT [GeV]", "precision": -1},
        "eta": {"expr": "eta()", "type": "float", "doc": "Pseudorapidity", "precision": -1},
        "phi": {"expr": "phi()", "type": "float", "doc": "Azimuthal angle", "precision": -1},
        "charge": {"expr": "charge()", "type": "int16", "doc": "Electric charge"},
        "vx": {"expr": "vx()", "type": "float", "doc": "Reference point x [cm]", "precision": -1},
        "vy": {"expr": "vy()", "type": "float", "doc": "Reference point y [cm]", "precision": -1},
        "vz": {"expr": "vz()", "type": "float", "doc": "Reference point z [cm]", "precision": -1},
        "dxyErr": {"expr": "dxyError()", "type": "float", "doc": "dxy uncertainty [cm]", "precision": -1},
        "dzErr": {"expr": "dzError()", "type": "float", "doc": "dz uncertainty [cm]", "precision": -1},
        "nPixelLayers": {"expr": "hitPattern().pixelLayersWithMeasurement()", "type": "uint8", "doc": "Pixel layers with a measurement"},
        "nStripLayers": {"expr": "hitPattern().stripLayersWithMeasurement()", "type": "uint8", "doc": "Strip layers with a measurement"}
      }
    },
    "VertexJet": {
      "_doc": "Jets the vertexer uses to separate vertices that share a jet. Not written to the ntuple.",
      "type": "vertexJet",
      "src": "slimmedJets",
      "jec": {"payload": "AK4PFchs", "primaryVertices": "offlineSlimmedPrimaryVertices", "levels": ["L1FastJet", "L2Relative", "L3Absolute", "L2L3Residual"]},
      "requirements": [{"definition": "analysisJet"}]
    },
    "DV": {
      "type": "dv",
      "src": "SeedTrack",
      "vertexing": {
        "beamSpot": "offlineBeamSpot",
        "jets": "VertexJet",
        "minTracks": 3,
        "maxChi2PerDof": 5,
        "kalman": {"maxDistance": 0.01, "maxIterations": 10, "smoothing": true},
        "sharedTracks": {"_doc": "When two vertices share a track, they merge if they are close, and otherwise the track stays only in the vertex it fits best.", "mergeBelowSigma": 4, "keepBelowSigma": 5, "tieBelowSigma": 1.5},
        "zRefit": {"_doc": "A track whose removal moves the vertex in z by more than maxShiftSigma standard deviations is dropped.", "maxShiftSigma": 3},
        "mergeNearby": {"deltaPhiBelow": 0.5, "distance2dBelow": 0.03, "dbvAbove": 0.01},
        "sharedJets": {"_doc": "When two vertices share a jet, a vertex's only track in that jet is dropped if its phi differs from the vertex's phi by more than maxDeltaPhi.", "maxDeltaPhi": 1.5707963267948966}
      },
      "variables": {
        "x": {"expr": "x()", "type": "float", "doc": "DV x [cm]", "precision": -1},
        "y": {"expr": "y()", "type": "float", "doc": "DV y [cm]", "precision": -1},
        "z": {"expr": "z()", "type": "float", "doc": "DV z [cm]", "precision": -1},
        "cxx": {"expr": "covariance(0,0)", "type": "float", "doc": "Position covariance xx [cm^2]", "precision": -1},
        "cxy": {"expr": "covariance(0,1)", "type": "float", "doc": "Position covariance xy [cm^2]", "precision": -1},
        "cxz": {"expr": "covariance(0,2)", "type": "float", "doc": "Position covariance xz [cm^2]", "precision": -1},
        "cyy": {"expr": "covariance(1,1)", "type": "float", "doc": "Position covariance yy [cm^2]", "precision": -1},
        "cyz": {"expr": "covariance(1,2)", "type": "float", "doc": "Position covariance yz [cm^2]", "precision": -1},
        "czz": {"expr": "covariance(2,2)", "type": "float", "doc": "Position covariance zz [cm^2]", "precision": -1},
        "chi2": {"expr": "chi2()", "type": "float", "doc": "Vertex fit chi2", "precision": -1},
        "ndof": {"expr": "ndof()", "type": "float", "doc": "Vertex fit ndof", "precision": -1},
        "nTracks": {"expr": "tracksSize()", "type": "uint8", "doc": "Seed tracks in the vertex"}
      }
    }
  }
}
