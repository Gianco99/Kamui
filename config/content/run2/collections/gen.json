{
  "_doc": "Generator-level content. All mcOnly.",
  "collections": {
    "GenPart": {
      "type": "genParticle",
      "src": "prunedGenParticles",
      "mcOnly": true,
      "doc": "Pruned generator particles",
      "variables": {
        "pt": {
          "expr": "pt()",
          "type": "float",
          "doc": "pT [GeV]",
          "precision": 10
        },
        "eta": {
          "expr": "eta()",
          "type": "float",
          "doc": "Pseudorapidity",
          "precision": 12
        },
        "phi": {
          "expr": "phi()",
          "type": "float",
          "doc": "Azimuthal angle",
          "precision": 12
        },
        "mass": {
          "expr": "mass()",
          "type": "float",
          "doc": "Mass [GeV]",
          "precision": 10
        },
        "pdgId": {
          "expr": "pdgId()",
          "type": "int",
          "doc": "PDG id"
        },
        "status": {
          "expr": "status()",
          "type": "int16",
          "doc": "Pythia status code"
        },
        "statusFlags": {
          "expr": "statusFlags().isLastCopyBeforeFSR()*16384+statusFlags().isLastCopy()*8192+statusFlags().isFirstCopy()*4096+statusFlags().fromHardProcessBeforeFSR()*2048+statusFlags().isDirectHardProcessTauDecayProduct()*1024+statusFlags().isHardProcessTauDecayProduct()*512+statusFlags().fromHardProcess()*256+statusFlags().isHardProcess()*128+statusFlags().isDirectHadronDecayProduct()*64+statusFlags().isDirectPromptTauDecayProduct()*32+statusFlags().isDirectTauDecayProduct()*16+statusFlags().isPromptTauDecayProduct()*8+statusFlags().isTauDecayProduct()*4+statusFlags().isDecayedLeptonHadron()*2+statusFlags().isPrompt()*1",
          "type": "uint16",
          "doc": "Gen status flags"
        },
        "genPartIdxMother": {
          "expr": "?numberOfMothers>0?motherRef(0).key():-1",
          "type": "int16",
          "doc": "Index of the first mother in this collection"
        },
        "vx": {
          "expr": "vx()",
          "type": "float",
          "doc": "Production vertex x [cm]",
          "precision": 14
        },
        "vy": {
          "expr": "vy()",
          "type": "float",
          "doc": "Production vertex y [cm]",
          "precision": 14
        },
        "vz": {
          "expr": "vz()",
          "type": "float",
          "doc": "Production vertex z [cm]",
          "precision": 14
        }
      }
    },
    "GenMET": {
      "type": "patMET",
      "src": "slimmedMETs",
      "singleton": true,
      "mcOnly": true,
      "doc": "Generator-level MET",
      "variables": {
        "pt": {
          "expr": "genMET().pt()",
          "type": "float",
          "doc": "Gen MET [GeV]",
          "precision": 10
        },
        "phi": {
          "expr": "genMET().phi()",
          "type": "float",
          "doc": "Gen MET phi",
          "precision": 10
        }
      }
    },
    "Pileup": {
      "type": "pileup",
      "src": "slimmedAddPileupInfo",
      "mcOnly": true,
      "doc": "True and observed PU"
    },
    "genWeight": {
      "type": "genWeight",
      "src": "generator",
      "mcOnly": true,
      "doc": "Nominal generator weight plus LHE scale/PS/PDF weights"
    }
  }
}
