{
  "collections": {
    "Muon": {
      "type": "patMuon",
      "src": "slimmedMuons",
      "cut": "pt > 5",
      "maxLen": 20,
      "doc": "Muons passing the collection's cut",
      "variables": {
        "pt": {"expr": "pt()", "type": "float", "doc": "pT [GeV]", "precision": -1},
        "eta": {"expr": "eta()", "type": "float", "doc": "Pseudorapidity", "precision": -1},
        "phi": {"expr": "phi()", "type": "float", "doc": "Azimuthal angle [rad]", "precision": -1},
        "charge": {"expr": "charge()", "type": "int16", "doc": "Electric charge"},
        "dxy": {"expr": "dB('PV2D')", "type": "float", "doc": "Signed transverse impact parameter to the first PV [cm]", "precision": -1},
        "dxyErr": {"expr": "edB('PV2D')", "type": "float", "doc": "dxy uncertainty [cm]", "precision": 8},
        "dxyBS": {"expr": "dB('BS2D')", "type": "float", "doc": "Signed transverse impact parameter to the beamspot [cm]", "precision": -1},
        "dz": {"expr": "dB('PVDZ')", "type": "float", "doc": "Signed longitudinal impact parameter to the first PV [cm]", "precision": -1},
        "dzErr": {"expr": "abs(edB('PVDZ'))", "type": "float", "doc": "dz uncertainty [cm]", "precision": 8},
        "sip3d": {"expr": "abs(dB('PV3D')/edB('PV3D'))", "type": "float", "doc": "3D impact parameter significance to the first PV", "precision": -1},
        "isGlobal": {"expr": "isGlobalMuon()", "type": "bool", "doc": "Is a global muon"},
        "isTracker": {"expr": "isTrackerMuon()", "type": "bool", "doc": "Is a tracker muon"},
        "isPFcand": {"expr": "isPFMuon()", "type": "bool", "doc": "Is a PF muon"},
        "looseId": {"expr": "passed('CutBasedIdLoose')", "type": "bool", "doc": "Passes the cut-based loose ID"},
        "mediumId": {"expr": "passed('CutBasedIdMedium')", "type": "bool", "doc": "Passes the cut-based medium ID"},
        "tightId": {"expr": "passed('CutBasedIdTight')", "type": "bool", "doc": "Passes the cut-based tight ID"},
        "pfIsoId": {"expr": "passed('PFIsoLoose')+passed('PFIsoMedium')+passed('PFIsoTight')", "type": "uint8", "doc": "PF isolation working points passed: 0 none, 1 loose, 2 medium, 3 tight"},
        "nTrackerLayers": {"expr": "?track.isNonnull?innerTrack().hitPattern().trackerLayersWithMeasurement():0", "type": "uint8", "doc": "Number of tracker layers with a measurement"},
        "nStations": {"expr": "numberOfMatchedStations()", "type": "uint8", "doc": "Number of matched muon stations"},
        "pfRelIso04": {"expr": "(pfIsolationR04().sumChargedHadronPt + max(0., pfIsolationR04().sumNeutralHadronEt + pfIsolationR04().sumPhotonEt - 0.5*pfIsolationR04().sumPUPt))/pt", "type": "float", "precision": -1, "doc": "PF relative isolation in a dR 0.4 cone, delta-beta corrected"},
        "vx": {"expr": "bestTrack().vx()", "type": "float", "precision": -1, "doc": "Reference point x of the best track [cm]"},
        "vy": {"expr": "bestTrack().vy()", "type": "float", "precision": -1, "doc": "Reference point y of the best track [cm]"},
        "vz": {"expr": "bestTrack().vz()", "type": "float", "precision": -1, "doc": "Reference point z of the best track [cm]"}
      }
    },
    "Electron": {
      "type": "patElectron",
      "src": "slimmedElectrons",
      "cut": "pt > 5",
      "maxLen": 20,
      "doc": "Electrons passing the collection's cut",
      "variables": {
        "pt": {"expr": "pt()", "type": "float", "doc": "pT [GeV]", "precision": -1},
        "eta": {"expr": "eta()", "type": "float", "doc": "Pseudorapidity", "precision": -1},
        "phi": {"expr": "phi()", "type": "float", "doc": "Azimuthal angle [rad]", "precision": -1},
        "charge": {"expr": "charge()", "type": "int16", "doc": "Electric charge"},
        "scEta": {"expr": "superCluster().eta()", "type": "float", "doc": "Supercluster pseudorapidity", "precision": -1},
        "dxy": {"expr": "dB('PV2D')", "type": "float", "doc": "Signed transverse impact parameter to the first PV [cm]", "precision": -1},
        "dxyBS": {"expr": "dB('BS2D')", "type": "float", "precision": 12, "doc": "Signed transverse impact parameter to the beamspot [cm]"},
        "dxyErr": {"expr": "edB('PV2D')", "type": "float", "doc": "dxy uncertainty [cm]", "precision": 8},
        "dz": {"expr": "dB('PVDZ')", "type": "float", "doc": "Signed longitudinal impact parameter to the first PV [cm]", "precision": -1},
        "dzErr": {"expr": "edB('PVDZ')", "type": "float", "doc": "dz uncertainty [cm]", "precision": 8},
        "sip3d": {"expr": "abs(dB('PV3D')/edB('PV3D'))", "type": "float", "doc": "3D impact parameter significance to the first PV", "precision": -1},
        "convVeto": {"expr": "passConversionVeto()", "type": "bool", "doc": "Passes the photon conversion veto"},
        "lostHits": {"expr": "gsfTrack().hitPattern().numberOfLostHits('MISSING_INNER_HITS')", "type": "uint8", "doc": "Number of missing inner hits on the GSF track"},
        "sieie": {"expr": "full5x5_sigmaIetaIeta()", "type": "float", "doc": "Shower width in eta, full 5x5 sigma_ietaieta", "precision": 10},
        "hoe": {"expr": "hadronicOverEm()", "type": "float", "doc": "Ratio of hadronic to EM energy, H/E", "precision": 8},
        "relIso": {"expr": "(pfIsolationVariables().sumChargedHadronPt + pfIsolationVariables().sumNeutralHadronEt + pfIsolationVariables().sumPhotonEt)/pt()", "type": "float", "doc": "PF relative isolation with no pileup correction", "precision": -1},
        "cutBased": {"expr": "electronID('cutBasedElectronID-Fall17-94X-V2-veto')+electronID('cutBasedElectronID-Fall17-94X-V2-loose')+electronID('cutBasedElectronID-Fall17-94X-V2-medium')+electronID('cutBasedElectronID-Fall17-94X-V2-tight')", "type": "uint8", "doc": "Cut-based Fall17-94X-V2 ID: 0 fail, 1 veto, 2 loose, 3 medium, 4 tight"},
        "mvaIsoWP90": {"expr": "electronID('mvaEleID-Fall17-iso-V2-wp90')", "type": "bool", "doc": "Passes the 90% efficiency working point of the Fall17-V2 MVA ID with isolation"},
        "mvaIsoWP80": {"expr": "electronID('mvaEleID-Fall17-iso-V2-wp80')", "type": "bool", "doc": "Passes the 80% efficiency working point of the Fall17-V2 MVA ID with isolation"},
        "vx": {"expr": "gsfTrack().vx()", "type": "float", "precision": -1, "doc": "Reference point x of the GSF track [cm]"},
        "vy": {"expr": "gsfTrack().vy()", "type": "float", "precision": -1, "doc": "Reference point y of the GSF track [cm]"},
        "vz": {"expr": "gsfTrack().vz()", "type": "float", "precision": -1, "doc": "Reference point z of the GSF track [cm]"}
      }
    }
  }
}
