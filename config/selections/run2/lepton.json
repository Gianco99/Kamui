{
  "_doc": "Run 2 lepton-triggered channel, for events that fired a single-muon or single-electron trigger.",
  "eras": ["2016", "2016APV", "2017", "2018"],
  "cuts": [
    {
      "name": "metFilters",
      "type": "flags",
      "flags": {
        "2016APV": [
          "Flag_goodVertices",
          "Flag_globalSuperTightHalo2016Filter",
          "Flag_HBHENoiseFilter",
          "Flag_HBHENoiseIsoFilter",
          "Flag_EcalDeadCellTriggerPrimitiveFilter",
          "Flag_BadPFMuonFilter",
          "Flag_BadPFMuonDzFilter",
          "Flag_hfNoisyHitsFilter",
          "Flag_eeBadScFilter"
        ],
        "2016": [
          "Flag_goodVertices",
          "Flag_globalSuperTightHalo2016Filter",
          "Flag_HBHENoiseFilter",
          "Flag_HBHENoiseIsoFilter",
          "Flag_EcalDeadCellTriggerPrimitiveFilter",
          "Flag_BadPFMuonFilter",
          "Flag_BadPFMuonDzFilter",
          "Flag_hfNoisyHitsFilter",
          "Flag_eeBadScFilter"
        ],
        "2017": [
          "Flag_goodVertices",
          "Flag_globalSuperTightHalo2016Filter",
          "Flag_HBHENoiseFilter",
          "Flag_HBHENoiseIsoFilter",
          "Flag_EcalDeadCellTriggerPrimitiveFilter",
          "Flag_BadPFMuonFilter",
          "Flag_BadPFMuonDzFilter",
          "Flag_hfNoisyHitsFilter",
          "Flag_eeBadScFilter",
          "Flag_ecalBadCalibFilter"
        ],
        "2018": [
          "Flag_goodVertices",
          "Flag_globalSuperTightHalo2016Filter",
          "Flag_HBHENoiseFilter",
          "Flag_HBHENoiseIsoFilter",
          "Flag_EcalDeadCellTriggerPrimitiveFilter",
          "Flag_BadPFMuonFilter",
          "Flag_BadPFMuonDzFilter",
          "Flag_hfNoisyHitsFilter",
          "Flag_eeBadScFilter",
          "Flag_ecalBadCalibFilter"
        ]
      },
      "doc": "Keeps events that pass every standard MET filter."
    },
    {
      "name": "leptonPlateau",
      "type": "anyOf",
      "doc": "Keeps events where a single-muon or single-electron path fired and a lepton of that flavor is on its plateau and passes ID and isolation.",
      "anyOf": [
        {
          "name": "muon",
          "doc": "A single-muon path fired and a muon is on its plateau.",
          "cuts": [
            {"name": "fired", "type": "trigger", "triggers": {"2016APV": ["HLT_IsoMu24_v*"], "2016": ["HLT_IsoMu24_v*"], "2017": ["HLT_IsoMu27_v*"], "2018": ["HLT_IsoMu24_v*"]}},
            {"name": "plateau", "type": "object", "collection": "Muon", "min": 1, "requirements": [{"definition": "plateauMuon"}]}
          ]
        },
        {
          "name": "electron",
          "doc": "A single-electron path fired and an electron is on its plateau, with looser impact parameter cuts beyond |eta| = 1.48.",
          "cuts": [
            {
              "name": "fired",
              "type": "trigger",
              "triggers": {"2016APV": ["HLT_Ele27_WPTight_Gsf_v*"], "2016": ["HLT_Ele27_WPTight_Gsf_v*"], "2017": ["HLT_Ele35_WPTight_Gsf_v*"], "2018": ["HLT_Ele32_WPTight_Gsf_v*"]}
            },
            {"name": "plateau", "type": "object", "collection": "Electron", "min": 1, "requirements": [{"definition": "plateauElectron"}]}
          ]
        }
      ]
    }
  ]
}
